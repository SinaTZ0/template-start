# The public edge of `compose.prod.yaml`: HTTPS, compression, security headers, the read-only media path, and everything
# else proxied to the app. `{$VAR}` is read from Caddy's environment when the file loads (set in `compose.prod.yaml`).

# ===== Certificates =====
# `TLS_MODE` picks one of these for both sites (docs/deployment.md → HTTPS Certificates). `auto`: Caddy gets and renews
# Let's Encrypt certificates for $DOMAIN and $ERRORS_DOMAIN. `files`: the certificate `deploy/deploy.sh` copied into
# `certs/`, which Caddy can't renew.
(tls-auto) {
}

(tls-files) {
	tls /certs/fullchain.pem /certs/key.pem
}

# ===== App =====
{$DOMAIN} {
	import tls-{$TLS_MODE:auto}
	encode zstd gzip

	# Above the app's 10 MB image limit (`MEDIA_MAX_BYTES`), plus room for the multipart encoding.
	request_body {
		max_size 12MB
	}

	# CSP stays in the app, which knows its inline scripts. `-Server` hides the proxy's name and version.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# The S3 store publishes no ports; this is its only public path, and only for image variants
	# (`{kind}/{mediaId}/{variant}.webp`, see `mediaKey` in `src/lib/storage.server.ts`). The fixed shape is what blocks
	# listing and every other S3 operation, so new media kinds need no change here.
	@media path /media /media/*
	handle @media {
		@image {
			method GET HEAD
			path_regexp image ^/media/([a-z][a-z0-9-]*/[0-9a-f-]{36}/[a-z][a-z0-9-]*\.webp)$
		}
		handle @image {
			# The trailing `?` drops the query string, so callers can't pick S3 operations (`?acl`, `?list-type`, ...).
			rewrite * /{$S3_BUCKET_NAME}/{re.image.1}?
			reverse_proxy seaweedfs:8333 {
				# Reads go through the store's anonymous identity: never forward the visitor's credentials or cookies.
				header_up Host seaweedfs:8333
				header_up -Authorization
				header_up -Cookie
				header_down -x-amz-request-id
				header_down -x-amz-id-2
			}
		}
		handle {
			respond 404
		}
	}

	handle {
		reverse_proxy app:3000 {
			# The app rate-limits by the visitor's address, which it reads from X-Real-IP (`src/lib/rate-limit.server.ts`).
			# Setting it replaces any value the visitor sent.
			header_up X-Real-IP {remote_host}
			# During an update `app` resolves to the old and the new container (deploy/deploy.sh, rollout_app). A request
			# that can't connect to the one that's stopping is retried for up to 5 seconds instead of failing.
			lb_try_duration 5s
		}
	}
}

# ===== Error Viewer =====
# The error viewer (tools/error-viewer). Public because browsers send their errors here; everything but the event
# intake and /healthz needs a sign-in. It sets its own CSP and framing headers.
{$ERRORS_DOMAIN} {
	import tls-{$TLS_MODE:auto}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	reverse_proxy error-viewer:8000 {
		# The viewer rate-limits by the visitor's address, which it reads from X-Real-IP.
		header_up X-Real-IP {remote_host}
	}
}
