{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "include": ["**/*", ".storybook/**/*"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"]
    },
    "esModuleInterop": true,
    // `verbatimModuleSyntax` stays off: TanStack Start's compiler relies on import elision to keep server-only modules
    // out of the client bundle (start-core skill → Common Mistakes).
    "noEmit": true,
    // Lets `vite.config.ts` import local plugins with their `.ts` extension, as Vite's native config loader needs.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    // Effect diagnostics, run by `effect-tsgo tsc` in `pnpm typecheck` (the `effect` skill). Warnings fail the
    // typecheck too. v3 APIs are errors: agents often reach for them. APIs Effect marks `@stability unstable` (sql,
    // persistence, observability, ErrorReporter) may change in a minor release, so each is wrapped once in
    // `src/server/` and used through that wrapper everywhere else.
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": { "outdatedApi": "error", "unstableApiUsage": "error", "schemaClassMissingBrand": "off" },
        "overrides": [
          { "include": ["src/server/**/*.ts"], "options": { "diagnosticSeverity": { "unstableApiUsage": "off" } } }
        ]
      }
    ]
  },
  "exclude": ["node_modules", ".output", "src/components/ui/**", "docs/frontend/reference/**", "target/**"]
}
