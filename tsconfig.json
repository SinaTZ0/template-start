{
  "include": ["**/*", ".storybook/**/*"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"]
    },
    "esModuleInterop": true,
    // `verbatimModuleSyntax` stays off: TanStack Start's compiler relies on import elision to keep server-only modules
    // out of the client bundle (start-core skill → Common Mistakes).
    "noEmit": true,
    // Lets `vite.config.ts` import local plugins with their `.ts` extension, as Vite's native config loader needs.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  },
  "exclude": ["node_modules", ".output", "src/components/ui/**"]
}
