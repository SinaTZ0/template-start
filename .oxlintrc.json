{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "vitest"],
  "jsPlugins": ["@shadcn/lint"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "settings": {
    "shadcn": {
      "ui": "#/components/primitive",
      "note": "Move the look into the primitive (a variant or its base style), the layout onto the parent, or a new token into src/styles.css (docs/frontend/components.md#lint-rules). Don't hide it in a wrapper element."
    }
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ],
    "shadcn/no-restyle": ["error", { "allow": ["layout"] }],
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": "error",
    "shadcn/no-inline-styles": "error"
  },
  "overrides": [
    {
      "files": ["src/components/primitive/**"],
      "rules": {
        "shadcn/no-restyle": "off"
      }
    }
  ],
  "ignorePatterns": [
    ".agents/",
    ".claude/",
    ".output/",
    ".tanstack/",
    ".nitro/",
    "src/routeTree.gen.ts",
    "playwright-report/",
    "test-results/",
    "storybook-static/",
    "src/components/ui/",
    "tools/error-viewer/static/htmx.min.js"
  ]
}
