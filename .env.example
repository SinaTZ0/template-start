# Copy to `.env` and fill in values. Validated by app/env.server.ts.
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL connection string, used by the app and Drizzle Kit (drizzle.config.ts).
# Matches compose.dev.yaml. Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# Better-Auth: signs session cookies. Generate with `openssl rand -base64 32` (min 32 chars).
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-32-chars-or-more
# Public origin of the app (the Vite dev server by default).
BETTER_AUTH_URL=http://localhost:5173

# Altcha: HMAC key that signs captcha challenges. Generate with `openssl rand -base64 32` (min 32 chars).
ALTCHA_HMAC_KEY=replace-with-another-random-secret-of-32-chars

# S3-compatible storage for uploaded images (docs/media.md). Matches compose.dev.yaml.
S3_ENDPOINT=http://localhost:8333
S3_BUCKET_NAME=app-media
# Any value works while S3 auth is off (local SeaweedFS).
S3_ACCESS_KEY=dev
S3_SECRET_KEY=dev
S3_REGION=us-east-1
# Where browsers read images. Development reads straight from SeaweedFS; production uses a proxy path like /media.
MEDIA_PUBLIC_URL=http://localhost:8333/app-media

# Used once by `pnpm db:seed` to create the first admin.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
