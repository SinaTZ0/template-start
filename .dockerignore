# Only what the image build needs; secrets and local state never enter the build context.
.git
.env
.env.*
node_modules
.output
.tanstack
.nitro
# Regenerated from messages/ by the build (docs/frontend/i18n.md).
src/paraglide
# The compiler's own cache. `project.inlang/cache/plugins` stays in: the committed inlang plugins, which the build
# falls back to where the server can't reach jsDelivr (docs/deployment.md → Package Registries).
project.inlang/cache/paraglide-js
.tmp-claude
src/routes/design_study
.claude
.agents
# Not part of the built app.
docs
e2e
.storybook
**/*.stories.tsx
.github
playwright-report
test-results
storybook-static
certs
backups
*.key
*.pfx
# The error viewer builds from its own folder (tools/error-viewer/Dockerfile).
tools
