# Production settings for `compose.prod.yaml` (docs/deployment.md). On the server, copy to `.env` next to it.
# Compose builds the containers' environment from these; the app's other settings are fixed in compose.prod.yaml.
#
# Generate every secret with `openssl rand -hex 32`. Hex matters: the values are placed inside the database URL and
# the store's JSON config, where `/`, `+`, `@` or quotes would break them. `deploy/deploy.sh` does all of this: it
# generates the secrets, asks for the rest, and adds variables that appear here later to an existing `.env`.
#
# A new variable here also needs an entry in the deploy tool's settings registry (`tools/deploy/internal/settings`); a
# required one that can't be generated needs one that asks for it (docs/deployment.md → Adding a Variable).

# The public hostname. Its DNS must point at this server.
DOMAIN=example.com

# HTTPS certificates for DOMAIN and ERRORS_DOMAIN (docs/deployment.md → HTTPS Certificates). `auto`: Caddy gets them
# from Let's Encrypt and renews them. `files`: your own, in `certs/fullchain.pem` and `certs/key.pem`; put them there
# with `deploy/deploy.sh cert <folder>`, and replace them before they expire.
TLS_MODE=auto

# Where `deploy/deploy.sh backup` writes, relative to this folder or absolute, and how many of each kind it keeps.
BACKUP_DIR=./backups
BACKUP_KEEP=14
# Optional: a copy of every backup in an S3-compatible bucket away from this server (docs/deployment.md → Backups).
# `deploy/deploy.sh offsite` asks for these and tries the bucket before saving them. The endpoint is the store's URL
# without the bucket (https://s3.eu-central-003.backblazeb2.com); empty turns the copies off. The keys must be able to
# read, write and delete in the bucket. BACKUP_S3_KEEP is how many of each kind stay in the bucket.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_KEEP=30
# Encrypts the copy of this file that goes to the bucket with the backups. Keep it somewhere else too: on a new server
# it's what reads that copy. Empty leaves this file out of the bucket.
BACKUP_ENV_PASSWORD=

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# The error viewer (`error-viewer` service), served at https://$ERRORS_DOMAIN; its DNS must point here too.
ERRORS_DOMAIN=errors.example.com
# The key in the DSN below. Public by design (browsers send it), but only allows sending events. Letters and digits
# only (`openssl rand -hex 16`): the Sentry SDKs silently drop a DSN whose key has anything else.
ERROR_VIEWER_PUBLIC_KEY=
# The dashboard's sign-in password.
ERROR_VIEWER_ADMIN_PASSWORD=
# Signs dashboard session cookies; rotating it signs you out.
ERROR_VIEWER_SESSION_SECRET=
# Optional: a chat webhook the error viewer posts to when a new kind of error shows up (docs/deployment.md → Error
# Tracking). A Slack, Mattermost, Rocket.Chat or Google Chat webhook as it is; for a Telegram-style bot API, the bot's
# `sendMessage` URL here and the chat in ERROR_VIEWER_NOTIFY_CHAT_ID. Empty turns notifications off. The deploy tool
# sends its alerts to the same chat: a scheduled backup that failed, a disk nearly full (docs/deploy-tool.md →
# Schedule and Alerts).
ERROR_VIEWER_NOTIFY_URL=
ERROR_VIEWER_NOTIFY_CHAT_ID=
# Where the app reports errors and slow requests: https://<ERROR_VIEWER_PUBLIC_KEY>@<ERRORS_DOMAIN>/1. Empty turns
# reporting off. The browser bundle bakes it in, so changing it needs a redeploy with `--build`.
SENTRY_DSN=
# Optional: traces (with their log lines) and metrics in OpenObserve (docs/deployment.md → Traces). It needs a few
# hundred MB of memory, so it's off by default. To turn it on: COMPOSE_PROFILES=observability, a password of 12
# characters or more with a lowercase and an uppercase letter, a digit and a symbol (OpenObserve won't start with a
# weaker one), the endpoint below, and the authorization: `Basic ` and the base64 of `admin@<DOMAIN>:<password>`
# (printf 'admin@example.com:the-password' | base64). Then ERROR_VIEWER_TRACE_URL links each report to its trace:
# http://localhost:5080/web/traces?org_identifier=default&trace_id={traceId}, opened through `ssh -L
# 5080:127.0.0.1:5080`.
COMPOSE_PROFILES=
OPENOBSERVE_ROOT_PASSWORD=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_AUTHORIZATION=
ERROR_VIEWER_TRACE_URL=
# Optional: a Go module mirror for building the error viewer, when this server can't reach proxy.golang.org (Google
# blocks some regions). Empty uses Go's default.
GOPROXY=
# Optional: an npm registry mirror for building the app (e.g. https://registry.npmmirror.com, no trailing slash), when
# this server can't reach registry.npmjs.org. Empty uses npm's. The deploy tool checks both before each build and
# offers a mirror for one that doesn't answer.
NPM_REGISTRY=

# Postgres (`db` service). Only containers in the stack can reach it.
POSTGRES_PASSWORD=

# Signs session cookies; rotating it signs everyone out.
BETTER_AUTH_SECRET=
# Signs sign-up captcha challenges.
ALTCHA_HMAC_KEY=

# SeaweedFS (`seaweedfs` service). The app's identity reads and writes this bucket only; the admin identity is used
# once per deploy, by `storage-init`, to create the bucket.
S3_BUCKET_NAME=app-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ADMIN_ACCESS_KEY=
S3_ADMIN_SECRET_KEY=

# The mailbox the app sends its email from: sign-up links and password resets (docs/backend/mail.md). Any mailbox that
# allows SMTP works. Gmail: smtp.gmail.com, port 465 or 587, the address as user and an app password (Google account →
# Security → 2-Step Verification → App passwords) without its spaces, never the account's own password. Port 465 is TLS
# from the start; 587 upgrades with STARTTLS. Some hosts block 465 (and 25) for new servers: use 587 there.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The address emails come from, e.g. myapp@gmail.com: just the address, the app adds its name. Most mailboxes only
# send as their own address.
MAIL_FROM=
