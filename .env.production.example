# Production settings for `compose.prod.yaml` (docs/deployment.md). On the server, copy to `.env` next to it.
# Compose builds the containers' environment from these; the app's other settings are fixed in compose.prod.yaml.
#
# Generate every secret with `openssl rand -hex 32`. Hex matters: the values are placed inside the database URL and
# the store's JSON config, where `/`, `+`, `@` or quotes would break them. `deploy/deploy.sh` does all of this: it
# generates the secrets, asks for the rest, and adds variables that appear here later to an existing `.env`.
#
# A new variable here also needs an entry in the deploy tool's settings registry (`tools/deploy/internal/settings`); a
# required one that can't be generated needs one that asks for it (docs/deployment.md → Adding a Variable).

# The public hostname. Its DNS must point at this server.
DOMAIN=example.com

# HTTPS certificates for DOMAIN and ERRORS_DOMAIN (docs/deployment.md → HTTPS Certificates). `auto`: Caddy gets them
# from Let's Encrypt and renews them. `files`: your own, in `certs/fullchain.pem` and `certs/key.pem`; put them there
# with `deploy/deploy.sh cert <folder>`, and replace them before they expire.
TLS_MODE=auto

# Where `deploy/deploy.sh backup` writes, relative to this folder or absolute, and how many of each kind it keeps.
BACKUP_DIR=./backups
BACKUP_KEEP=14

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# The error viewer (`error-viewer` service), served at https://$ERRORS_DOMAIN; its DNS must point here too.
ERRORS_DOMAIN=errors.example.com
# The key in the DSN below. Public by design (browsers send it), but only allows sending events. Letters and digits
# only (`openssl rand -hex 16`): the Sentry SDKs silently drop a DSN whose key has anything else.
ERROR_VIEWER_PUBLIC_KEY=
# The dashboard's sign-in password.
ERROR_VIEWER_ADMIN_PASSWORD=
# Signs dashboard session cookies; rotating it signs you out.
ERROR_VIEWER_SESSION_SECRET=
# Where the app reports errors and slow requests: https://<ERROR_VIEWER_PUBLIC_KEY>@<ERRORS_DOMAIN>/1. Empty turns
# reporting off. The browser bundle bakes it in, so changing it needs a redeploy with `--build`.
SENTRY_DSN=
# Optional: a Go module mirror for building the error viewer, when this server can't reach proxy.golang.org (Google
# blocks some regions). Empty uses Go's default.
GOPROXY=
# Optional: an npm registry mirror for building the app (e.g. https://registry.npmmirror.com, no trailing slash), when
# this server can't reach registry.npmjs.org. Empty uses npm's. The deploy tool checks both before each build and
# offers a mirror for one that doesn't answer.
NPM_REGISTRY=

# Postgres (`db` service). Only containers in the stack can reach it.
POSTGRES_PASSWORD=

# Signs session cookies; rotating it signs everyone out.
BETTER_AUTH_SECRET=
# Signs sign-up captcha challenges.
ALTCHA_HMAC_KEY=

# SeaweedFS (`seaweedfs` service). The app's identity reads and writes this bucket only; the admin identity is used
# once per deploy, by `storage-init`, to create the bucket.
S3_BUCKET_NAME=app-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ADMIN_ACCESS_KEY=
S3_ADMIN_SECRET_KEY=
