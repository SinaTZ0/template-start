{
  "name": "template-start",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "NODE_ENV=production vite build",
    "dev": "vite dev",
    "start": "node .output/server/index.mjs",
    "typecheck": "pnpm i18n:compile && tsc",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:tw": "node scripts/lint-tw.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "services": "docker compose -f compose.dev.yaml up -d && node --env-file=.env deploy/init-storage.mjs",
    "errors": "cd tools/error-viewer && PUBLIC_KEY=developmentkey ADMIN_PASSWORD=admin SESSION_SECRET=development-only-session-secret-at-least-32-characters ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3000 BASE_URL=http://localhost:8000 DATA_DIR=./data go run .",
    "prepare": "lefthook install && pnpm i18n:compile",
    "i18n:compile": "paraglide-js compile --silent",
    "generate-routes": "tsr generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@hookform/resolvers": "^6.0.0",
    "@inlang/paraglide-js": "^2.29.1",
    "@orpc/client": "^2.0.0-beta.45",
    "@orpc/contract": "^2.0.0-beta.45",
    "@orpc/server": "^2.0.0-beta.45",
    "@orpc/tanstack-query": "^2.0.0-beta.45",
    "@sentry/browser": "^11.9.0",
    "@sentry/node": "^11.9.0",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "altcha": "^3.5.0",
    "altcha-lib": "^2.7.0",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "jotai": "^3.0.1",
    "lucide-react": "^1.61.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-resizable-panels": "^4.14.8",
    "shadcn": "^4.22.1",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@shadcn/lint": "^0.2.3",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/virtual-file-routes": "^1.162.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "lefthook": "^2.2.2",
    "nitro": "3.0.260903-beta",
    "oxlint": "^1.89.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "imports": {
    "#/*": "./src/*"
  }
}
