{
  "name": "template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx app/db/seed.ts",
    "services": "docker compose -f compose.dev.yaml up -d && node --env-file=.env deploy/init-storage.mjs",
    "errors": "cd tools/error-viewer && PUBLIC_KEY=developmentkey ADMIN_PASSWORD=admin SESSION_SECRET=development-only-session-secret-at-least-32-characters ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3000 BASE_URL=http://localhost:8000 DATA_DIR=./data go run .",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@orpc/client": "^2.0.0-beta.42",
    "@orpc/contract": "^2.0.0-beta.42",
    "@orpc/server": "^2.0.0-beta.42",
    "@orpc/tanstack-query": "^2.0.0-beta.42",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@sentry/browser": "^11.1.0",
    "@sentry/node": "^11.1.0",
    "@tanstack/react-query": "^5.104.1",
    "altcha": "^3.3.0",
    "altcha-lib": "^2.6.0",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "isbot": "^5.1.36",
    "jotai": "^3.0.1",
    "lucide-react": "^1.52.0",
    "nuqs": "^2.10.1",
    "pg": "^8.23.1",
    "pino": "^10.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router": "^8.4.0",
    "shadcn": "^4.21.2",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@shadcn/lint": "^0.2.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "^0.31.11",
    "lefthook": "^2.2.2",
    "oxlint": "^1.87.0",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.0.3"
  }
}
