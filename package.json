{
  "name": "template-start",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "NODE_ENV=production vite build",
    "dev": "vite dev",
    "start": "node .output/server/index.mjs",
    "typecheck": "pnpm i18n:compile && pnpm generate-routes && effect-tsgo tsc",
    "lint": "oxlint && pnpm -s lint:i18n && pnpm -s lint:effect",
    "lint:fix": "oxlint --fix",
    "lint:tw": "node scripts/lint-tw.mjs",
    "lint:i18n": "node scripts/i18n-check.mjs",
    "lint:effect": "node scripts/lint-effect.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:reset": "docker compose -f compose.dev.yaml exec -T db psql -U postgres -d postgres -c 'drop database if exists app with (force)' -c 'create database app' && pnpm db:migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:notes": "tsx src/db/seed-notes.ts",
    "services": "docker compose -f compose.dev.yaml up -d --wait && node --env-file=.env deploy/init-storage.mjs",
    "services:down": "docker compose -f compose.dev.yaml down",
    "errors": "cd tools/error-viewer && PUBLIC_KEY=developmentkey ADMIN_PASSWORD=admin SESSION_SECRET=development-only-session-secret-at-least-32-characters ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3000 BASE_URL=http://localhost:8000 SOURCEMAP_ORIGIN=http://localhost:3000 DATA_DIR=./data go run .",
    "deploy:build": "bash tools/deploy/build.sh",
    "prepare": "pnpm i18n:compile && pnpm generate-routes && node scripts/install-hooks.mjs",
    "i18n:compile": "paraglide-js compile --silent --output-structure locale-modules",
    "generate-routes": "tsr generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@base-ui/react": "^1.9.0",
    "@effect/sql-pg": "4.1.4",
    "@hookform/resolvers": "^7.0.6",
    "@inlang/paraglide-js": "^3.2.2",
    "@orpc/client": "^2.0.0-beta.50",
    "@orpc/contract": "^2.0.0-beta.50",
    "@orpc/server": "^2.0.0-beta.50",
    "@orpc/tanstack-query": "^2.0.0-beta.50",
    "@react-email/render": "^2.3.1",
    "@sentry/browser": "^11.12.0",
    "@sentry/node": "^11.12.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "altcha": "^3.6.0",
    "altcha-lib": "^2.8.0",
    "better-auth": "^1.7.22",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.1.4",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "jotai": "^3.0.2",
    "lucide-react": "^1.72.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.13",
    "react-hook-form": "^7.92.0",
    "react-resizable-panels": "^4.21.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@effect/tsgo": "0.70.0",
    "@effect/vitest": "4.1.4",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@shadcn/lint": "^0.2.5",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/node": "^4.3.5",
    "@tailwindcss/oxide": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/router-cli": "^1.168.0",
    "@tanstack/virtual-file-routes": "^1.162.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "1.0.0-rc.5",
    "esbuild": "0.28.2",
    "lefthook": "^2.2.2",
    "nitro": "3.0.261103-rc",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "imports": {
    "#/*": "./src/*"
  }
}
